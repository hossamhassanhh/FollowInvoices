<div style="position: center;">
    <input class="auto-fit-input" value="@ViewBag.ViewName" disabled />
</div>
<div class="form-container">
    <div class="input-wrapper">
        <label>يرجي ادخال اسم الموظف</label>
        <select id="employee-name" required>
            @{ var employees = (ViewBag.Employees ?? FollowInvoices.Models.EmployeeDirectory.CairoEmployees); }
            @for (var j = 0; j < employees.Count; j++)
            {
                if (j == 0)
                {
                    <option value="@employees[j]" selected>@employees[j]</option>
                }
                else
                {
                    <option value="@employees[j]">@employees[j]</option>
                }
            }
</select>
    </div>
    <div class="input-wrapper">
        <label for="delivery-status">تسليم القيود</label>
        <select id="delivery-status">
            <option value="" selected>الكل</option>
            <option value="notEmpty">تم التسليم</option>
            <option value="empty">لم يتم التسليم</option>
        </select>
    </div>
    <div class="button-container">
        <button class="custom-btn" onclick="FilterByEmployeeReport()">تنفيذ</button>
        <button class="custom-btn" onclick="GoToQueryMainPage()">الرجوع إلي قائمة التقارير</button>
        <button class="custom-btn" onclick="GoToHomePage()">الرجوع إلي القائمة الرئيسية</button>
    </div>
</div>

<script src="/js/jquery-3.7.1.min.js"></script>

<script type="text/javascript">
    function getElementValue(elementId) {
        const element = document.getElementById(elementId);

        if (!element) {
            console.error(`Element with ID ${elementId} not found.`);
            return null;
        }

        // Check if the element is a select dropdown
        if (element.tagName === 'SELECT') {
            return element.options[element.selectedIndex]?.value || '';
        }
        // Check if the element is an input, textarea, or other input-like element
        else if (element.tagName === 'INPUT' || element.tagName === 'TEXTAREA') {
            return element.value;
        }
        // Handle other cases (e.g., div, span, etc.)
        else {
            console.error(`Unsupported element type: ${element.tagName}`);
            return null;
        }
    }
    function GoToQueryMainPage() {
        var url = '@Url.Action("Query", "Home")';
        window.location.href = url;
    }
    function GoToHomePage() {
        var url = '@Url.Action("Index", "Home")';
        // Redirect to the URL
        window.location.href = url;
    }
    function FilterByEmployeeReport() {
        var id = getElementValue("employee-name");
        var deliveryStatus = getElementValue("delivery-status");
        var url = '@Url.Action("FilterByEmployeeReport", "Home")' +
            '?id=' + encodeURIComponent(id) +
            '&deliveryStatus=' + encodeURIComponent(deliveryStatus);

        // Redirect to the URL
        window.location.href = url;
    }
</script>