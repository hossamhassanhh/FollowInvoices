@* <h2>تسليم القيود</h2> *@
<div class="reports-container">
    <h2>شاشة تسليم القيود</h2>

    <div class="reports-grid">
        <a href="@Url.Action("FilterByTasweyatReportView", "Home")" class="report-card">
            <span>⚖️</span>
            <p>تسويات</p>
        </a>

        <a href="@Url.Action("FilterBy7sabatReportView", "Home")" class="report-card">
            <span>📚</span>
            <p>حسابات</p>
        </a>

        <a href="@Url.Action("FilterByMasrafyaReportView", "Home")" class="report-card">
            <span>🏦</span>
            <p>مصرفية</p>
        </a>

        <a href="@Url.Action("FilterByMuraja3aReportView", "Home")" class="report-card">
            <span>📝</span>
            <p>المراجعة</p>
        </a>
    </div>

    <div class="button-container">
        <button class="custom-btn" onclick="GoToHomePage()">الرجوع إلى القائمة الرئيسية</button>
    </div>
</div>

<script type="text/javascript">
    function GoToHomePage() {
        var url = '@Url.Action("Index", "Home")';
        window.location.href = url;
    }
</script>
